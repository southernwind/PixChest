<local:FolderGroupExecutionConfigViewUserControl
	x:Class="MediaDeck.MediaItemTypes.UI.FolderGroup.Views.FolderGroupExecutionConfigView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.MediaItemTypes.UI.FolderGroup.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:enum="using:MediaDeck.Composition.Enum"
	xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
	x:DataType="local:FolderGroupExecutionConfigView"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ctConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</UserControl.Resources>

	<StackPanel Spacing="10" Margin="0,10,0,0">
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
			<ComboBox Grid.Column="0" Header="実行方法"
				HorizontalAlignment="Stretch"
				ItemsSource="{x:Bind ViewModel.ExecutionTypeConditions, Mode=OneWay}"
				SelectedItem="{x:Bind ViewModel.ExecutionType.Value, Mode=TwoWay}">
			</ComboBox>

			<ToggleSwitch Grid.Column="1" VerticalAlignment="Bottom"
				IsOn="{x:Bind ViewModel.IsDefault.Value, Mode=TwoWay}"
				Header="既定ツール" />
		</Grid>

		<!-- 外部プログラム設定 -->
		<Grid ColumnDefinitions="*,Auto"
			Visibility="{x:Bind ViewModel.IsExternal.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
			<TextBox Grid.Column="0"
				Margin="0,0,8,0"
				Text="{x:Bind ViewModel.Path.Value, Mode=TwoWay}"
				PlaceholderText="C:\Programs\MPC-BE\mpc-be64.exe"
				Header="実行ファイルパス" />

			<TextBox Grid.Column="1"
				Width="200"
				Text="{x:Bind ViewModel.Args.Value, Mode=TwoWay}"
				PlaceholderText="/fullscreen"
				Header="起動引数" />
		</Grid>
        
		<TextBlock Text="MediaDeckのライブラリ画面でこのフォルダを開きます。" 
			Style="{StaticResource CaptionTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Visibility="{x:Bind ViewModel.IsInternal.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
	</StackPanel>
</local:FolderGroupExecutionConfigViewUserControl>
